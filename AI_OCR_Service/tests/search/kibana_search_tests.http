# ==============================================================================
# KIBANA DEV TOOLS CONSOLE - SEARCH TEST CASES
# ==============================================================================
# 
# Copy and paste these commands into Kibana Dev Tools Console:
# http://localhost:5601/app/dev_tools#/console
#
# These test cases correspond to the search endpoints in app/api/search.py
# and query builders in app/services/search_indexer.py
#
# Index: prescriptions_current
# ==============================================================================


# ==============================================================================
# SECTION 1: INDEX MANAGEMENT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1.1 Check if index exists
# ------------------------------------------------------------------------------
# Corresponds to: Index health checks in search_indexer.py
HEAD /prescriptions_current


# ------------------------------------------------------------------------------
# 1.2 Create index with mappings (from setup_elasticsearch.py)
# ------------------------------------------------------------------------------
# Corresponds to: AsyncSearchService.create_index_if_not_exists()
PUT /prescriptions_current
{
  "settings": {
    "number_of_shards": 1,
    "analysis": {
      "analyzer": {
        "english_custom": {
          "type": "standard",
          "stopwords": "_english_"
        },
        "lowercase_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "prescription_id": { "type": "keyword" },
      "user_id": { "type": "keyword" },
      "doctor_name": { "type": "search_as_you_type" },
      "hospital": { "type": "search_as_you_type" },
      "medicine_names": { "type": "search_as_you_type" },
      "patient_name": { "type": "text" },
      "diagnosis": { "type": "text" },
      "raw_text": {
        "type": "text",
        "analyzer": "english_custom"
      },
      "created_at": { "type": "date" },
      "medicines": { "type": "object" },
      "doctor": { "type": "object" },
      "hospital_info": { "type": "object" },
      "patient": { "type": "object" }
    }
  }
}


# ------------------------------------------------------------------------------
# 1.3 Get index mappings
# ------------------------------------------------------------------------------
GET /prescriptions_current/_mapping


# ------------------------------------------------------------------------------
# 1.4 Get index settings
# ------------------------------------------------------------------------------
GET /prescriptions_current/_settings


# ------------------------------------------------------------------------------
# 1.5 Delete index (USE WITH CAUTION)
# ------------------------------------------------------------------------------
# DELETE /prescriptions_current


# ------------------------------------------------------------------------------
# 1.6 Count documents in index
# ------------------------------------------------------------------------------
# Corresponds to: Index stats check in search.py health endpoint
GET /prescriptions_current/_count


# ==============================================================================
# SECTION 2: SAMPLE DOCUMENT OPERATIONS
