# ==============================================================================
# SECTION 10: BULK OPERATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# 10.1 Bulk index multiple documents
# ------------------------------------------------------------------------------
POST /_bulk
{ "index": { "_index": "prescriptions_current", "_id": "rx_006" } }
{ "prescription_id": "rx_006", "user_id": "1", "doctor_name": "Dr. Lisa Anderson", "hospital": "Community Health Center", "medicine_names": ["Azithromycin", "Vitamin C"], "raw_text": "Azithromycin 250mg for 5 days, Vitamin C 500mg daily", "created_at": "2024-06-01T10:00:00Z" }
{ "index": { "_index": "prescriptions_current", "_id": "rx_007" } }
{ "prescription_id": "rx_007", "user_id": "1", "doctor_name": "Dr. James Wilson", "hospital": "University Hospital", "medicine_names": ["Omeprazole", "Domperidone"], "raw_text": "Omeprazole 20mg before breakfast, Domperidone 10mg as needed", "created_at": "2024-06-15T14:30:00Z" }


# ==============================================================================
# SECTION 11: ADVANCED FILTERING & COMPOUND QUERIES
# ==============================================================================

# ------------------------------------------------------------------------------
# 11.1 Search with multiple filters (medicine + date range + doctor)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } },
        {
          "range": {
            "created_at": {
              "gte": "2024-01-01",
              "lte": "2024-12-31"
            }
          }
        },
        { "term": { "doctor_name.keyword": "Dr. Sarah Johnson" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 11.2 Search with must_not (exclude certain medicines)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        { "match_all": {} }
      ],
      "must_not": [
        { "match": { "medicine_names": "Paracetamol" } }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 11.3 Nested bool query (complex filtering)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "bool": {
            "should": [
              { "match": { "medicine_names": "Aspirin" } },
              { "match": { "medicine_names": "Clopidogrel" } }
            ],
            "minimum_should_match": 1
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } },
        {
          "range": {
            "created_at": {
              "gte": "2024-01-01"
            }
          }
        }
      ]
    }
  }
}


# ==============================================================================
# SECTION 12: SEARCH TEMPLATES (for reusable queries)
# ==============================================================================

# ------------------------------------------------------------------------------
# 12.1 Store a search template
# ------------------------------------------------------------------------------
POST /_scripts/prescription_search_template
{
  "script": {
    "lang": "mustache",
    "source": {
      "size": "{{size}}",
      "query": {
        "bool": {
          "must": [
            {
              "multi_match": {
                "query": "{{query}}",
                "fields": ["medicine_names^3", "doctor_name", "hospital", "raw_text"],
                "fuzziness": "AUTO"
              }
            }
          ],
          "filter": [
            { "term": { "user_id": "{{user_id}}" } }
          ]
        }
      }
    }
  }
}


# ------------------------------------------------------------------------------
# 12.2 Use the search template
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search/template
{
  "id": "prescription_search_template",
  "params": {
    "query": "Paracetamol",
    "user_id": "1",
    "size": "10"
  }
}


# ==============================================================================
# QUICK REFERENCE: API Endpoints to Kibana Query Mapping
# ==============================================================================
#
# GET /search/health              -> GET /_cluster/health
# GET /search/medicine            -> Section 3.3 (fuzzy medicine search)
# GET /search/provider            -> Section 3.5 (doctor/hospital search)
# GET /search/all                 -> Section 4.1 (universal search)
# GET /search/date-range          -> Section 4.5 (date range search)
# GET /search/autocomplete        -> Section 4.4 (autocomplete)
# GET /search/fuzzy               -> Section 4.3 (fuzzy with tuning)
# GET /search/direct-search       -> Section 3.4 (multi-match)
# GET /search/medicine-async      -> Section 3.3 (same as /medicine)
# GET /search/health-new          -> GET /_cluster/health
#
# ==============================================================================