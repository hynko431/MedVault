# ==============================================================================
# SECTION 3: BASIC SEARCH QUERIES
# ==============================================================================

# ------------------------------------------------------------------------------
# 3.1 Match all documents (User ID: 1)
# ------------------------------------------------------------------------------
# Corresponds to: Base query structure used across all endpoints
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 3.2 Simple match query on medicine_names
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/medicine?q=Paracetamol&user_id=1
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 3.3 Fuzzy match on medicine names (AUTO fuzziness)
# ------------------------------------------------------------------------------
# Corresponds to: QueryBuilder.build_medicine_search() with fuzziness: AUTO
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": {
              "query": "Paracetamol",
              "fuzziness": "AUTO"
            }
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 3.4 Multi-match across multiple fields
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/direct-search (direct_es_search endpoint)
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "multi_match": {
            "query": "rocky mountain",
            "fields": ["medicine_names^3", "doctor_name", "hospital", "raw_text"],
            "fuzziness": "AUTO"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 3.5 Search by doctor name or hospital (should query)
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/provider?q=Sarah&user_id=1
# Corresponds to: QueryBuilder.build_doctor_hospital_search()
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "should": [
        { "match": { "doctor_name": "Sarah" } },
        { "match": { "hospital": "Sarah" } }
      ],
      "minimum_should_match": 1,
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 3.6 Match phrase for exact phrase matching
# ------------------------------------------------------------------------------
# Corresponds to: QueryBuilder.build_combined_search() - exact match priority
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "should": [
        {
          "match_phrase": {
            "medicine_names": {
              "query": "Vitamin D",
              "boost": 8.0
            }
          }
        }
      ],
      "minimum_should_match": 1,
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ==============================================================================
# SECTION 4: ADVANCED SEARCH QUERIES
# ==============================================================================

# ------------------------------------------------------------------------------
# 4.1 Universal search with combined fields and boosts
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/all?q=Paracetamol&user_id=1&page=1&page_size=10
# Corresponds to: QueryBuilder.build_combined_search() with relevance sorting
GET /prescriptions_current/_search
{
  "from": 0,
  "size": 10,
  "sort": ["_score"],
  "query": {
    "function_score": {
      "query": {
        "bool": {
          "should": [
            {
              "match_phrase": {
                "medicine_names": {
                  "query": "Paracetamol",
                  "boost": 8.0
                }
              }
            },
            {
              "match": {
                "medicine_names": {
                  "query": "Paracetamol",
                  "boost": 5.0
                }
              }
            },
            {
              "match_phrase": {
                "doctor_name": {
                  "query": "Paracetamol",
                  "boost": 4.0
                }
              }
            },
            {
              "match": {
                "doctor_name": {
                  "query": "Paracetamol",
                  "boost": 2.0
                }
              }
            },
            {
              "match_phrase": {
                "hospital": {
                  "query": "Paracetamol",
                  "boost": 2.0
                }
              }
            },
            {
              "match": {
                "hospital": {
                  "query": "Paracetamol",
                  "boost": 1.0
                }
              }
            }
          ],
          "minimum_should_match": 1,
          "filter": [
            { "term": { "user_id": "1" } }
          ]
        }
      },
      "functions": [
        {
          "gauss": {
            "created_at": {
              "origin": "now",
              "scale": "30d",
              "decay": 0.5
            }
          }
        }
      ],
      "score_mode": "avg",
      "boost_mode": "sum"
    }
  }
}


# ------------------------------------------------------------------------------
# 4.2 Universal search sorted by date
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/all?q=Paracetamol&user_id=1&sort_by=date
GET /prescriptions_current/_search
{
  "from": 0,
  "size": 10,
  "sort": [
    { "created_at": { "order": "desc" } }
  ],
  "query": {
    "function_score": {
      "query": {
        "bool": {
          "should": [
            {
              "match_phrase": {
                "medicine_names": {
                  "query": "Paracetamol",
                  "boost": 8.0
                }
              }
            },
            {
              "match": {
                "medicine_names": {
                  "query": "Paracetamol",
                  "boost": 5.0
                }
              }
            }
          ],
          "minimum_should_match": 1,
          "filter": [
            { "term": { "user_id": "1" } }
          ]
        }
      },
      "functions": [
        {
          "gauss": {
            "created_at": {
              "origin": "now",
              "scale": "30d",
              "decay": 0.5
            }
          }
        }
      ],
      "score_mode": "avg",
      "boost_mode": "sum"
    }
  }
}


# ------------------------------------------------------------------------------
# 4.3 Fuzzy search with safe tuning
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/fuzzy?q=Pacetamol&user_id=1 (typo in query)
# Corresponds to: QueryBuilder.build_fuzzy_search()
GET /prescriptions_current/_search
{
  "from": 0,
  "size": 10,
  "sort": ["_score"],
  "query": {
    "bool": {
      "should": [
        {
          "match": {
            "medicine_names": {
              "query": "Pacetamol",
              "fuzziness": "AUTO",
              "prefix_length": 2,
              "max_expansions": 50,
              "boost": 3.0
            }
          }
        },
        {
          "match": {
            "doctor_name": {
              "query": "Pacetamol",
              "fuzziness": "AUTO",
              "prefix_length": 2,
              "max_expansions": 50,
              "boost": 1.5
            }
          }
        },
        {
          "match": {
            "hospital": {
              "query": "Pacetamol",
              "fuzziness": "AUTO",
              "prefix_length": 2,
              "max_expansions": 50,
              "boost": 1.0
            }
          }
        }
      ],
      "minimum_should_match": 1,
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 4.4 Autocomplete search with exact match priority
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/autocomplete?q=Para&user_id=1
# Corresponds to: QueryBuilder.build_autocomplete_search()
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "should": [
        {
          "match_phrase": {
            "medicine_names": {
              "query": "Para",
              "boost": 10.0
            }
          }
        },
        {
          "match": {
            "medicine_names": {
              "query": "Para",
              "operator": "and",
              "boost": 5.0
            }
          }
        },
        {
          "match_phrase": {
            "doctor_name": {
              "query": "Para",
              "boost": 5.0
            }
          }
        },
        {
          "match": {
            "doctor_name": {
              "query": "Para",
              "boost": 2.0
            }
          }
        },
        {
          "match_phrase": {
            "hospital": {
              "query": "Para",
              "boost": 3.0
            }
          }
        },
        {
          "match": {
            "hospital": {
              "query": "Para",
              "boost": 1.0
            }
          }
        }
      ],
      "minimum_should_match": 1,
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 4.5 Date range search
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/date-range?q=Paracetamol&user_id=1&start_date=2024-01-01&end_date=2024-03-31
# Corresponds to: QueryBuilder.build_date_range_search()
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": {
              "query": "Paracetamol",
              "fuzziness": "AUTO"
            }
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } },
        {
          "range": {
            "created_at": {
              "gte": "2024-01-01",
              "lte": "2024-03-31"
            }
          }
        }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 4.6 Search with pagination (Page 2, 5 results per page)
# ------------------------------------------------------------------------------
# Corresponds to: GET /search/all?q=Paracetamol&user_id=1&page=2&page_size=5
GET /prescriptions_current/_search
{
  "from": 5,
  "size": 5,
  "sort": ["_score"],
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ==============================================================================
# SECTION 5: AGGREGATION QUERIES
# ==============================================================================

# ------------------------------------------------------------------------------
# 5.1 Get all unique medicine names for a user
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "aggs": {
    "unique_medicines": {
      "terms": {
        "field": "medicine_names",
        "size": 50
      }
    }
  }
}


# ------------------------------------------------------------------------------
# 5.2 Get prescription count by doctor
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "aggs": {
    "prescriptions_by_doctor": {
      "terms": {
        "field": "doctor_name.keyword",
        "size": 20
      }
    }
  }
}


# ------------------------------------------------------------------------------
# 5.3 Get prescription count by hospital
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "aggs": {
    "prescriptions_by_hospital": {
      "terms": {
        "field": "hospital.keyword",
        "size": 20
      }
    }
  }
}


# ------------------------------------------------------------------------------
# 5.4 Get prescriptions by month (date histogram)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "aggs": {
    "prescriptions_over_time": {
      "date_histogram": {
        "field": "created_at",
        "calendar_interval": "month",
        "format": "yyyy-MM"
      }
    }
  }
}


# ------------------------------------------------------------------------------
# 5.5 Get top medicines with prescription counts
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "aggs": {
    "top_medicines": {
      "terms": {
        "field": "medicine_names",
        "size": 10,
        "order": { "_count": "desc" }
      }
    }
  }
}


# ==============================================================================
# SECTION 6: FULL TEXT SEARCH QUERIES
# ==============================================================================

# ------------------------------------------------------------------------------
# 6.1 Search in raw_text field (English analyzer)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "raw_text": "fever management"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 6.2 Query string search (powerful Lucene syntax)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "default_field": "raw_text",
            "query": "Paracetamol AND (fever OR pain)"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 6.3 Wildcard search (use sparingly - performance intensive)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "wildcard": {
            "medicine_names": {
              "value": "Para*",
              "boost": 1.0
            }
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 6.4 Prefix search (faster than wildcard)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "prefix": {
            "medicine_names": "Para"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ==============================================================================
# SECTION 7: HIGHLIGHTING & SOURCE FILTERING
# ==============================================================================

# ------------------------------------------------------------------------------
# 7.1 Search with highlighting
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  },
  "highlight": {
    "fields": {
      "medicine_names": {},
      "raw_text": {}
    },
    "pre_tags": ["<mark>"],
    "post_tags": ["</mark>"]
  }
}


# ------------------------------------------------------------------------------
# 7.2 Search with source filtering (return only specific fields)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "_source": ["prescription_id", "doctor_name", "medicine_names", "created_at"],
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


# ------------------------------------------------------------------------------
# 7.3 Search excluding source (only get metadata)
# ------------------------------------------------------------------------------
GET /prescriptions_current/_search
{
  "size": 10,
  "_source": false,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "medicine_names": "Paracetamol"
          }
        }
      ],
      "filter": [
        { "term": { "user_id": "1" } }
      ]
    }
  }
}


